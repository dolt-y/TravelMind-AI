# 内部管理接口密钥，不得暴露给普通前端或复用为用户登录凭证。
TRAVELMIND_ADMIN_KEY=replace_with_a_long_random_value

# 系统内容账号 Cookie；管理员也可以通过受保护的内部接口更新运行会话。
TRAVELMIND_XHS_COOKIE=a1=replace_me; web_session=replace_me

# OpenAI-compatible LLM 配置，用于从笔记正文提取景点候选。
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini
LLM_TIMEOUT=180
LLM_ENABLE_THINKING=false

# SQLite 数据目录，默认保存到项目根目录 data/
# TRAVELMIND_DATA_DIR=/绝对路径/travelmind-data

# 高德 Web 服务 Key，用于 POI、天气和路线等后端事实查询。
AMAP_API_KEY=replace_me

# 天气缓存有效期，单位为秒，默认 3 小时。
WEATHER_CACHE_TTL_SECONDS=10800

# 酒店搜索缓存有效期，单位为秒，默认 24 小时。
HOTEL_CACHE_TTL_SECONDS=86400

# 路线查询缓存有效期，单位为秒，默认 24 小时。
ROUTE_CACHE_TTL_SECONDS=86400

# Docker Compose 对外提供 Web 服务的端口。
TRAVELMIND_WEB_PORT=8081

# Docker 构建前端时使用；本地 npm run dev 仍读取 ui/.env。
VITE_AMAP_JS_KEY=replace_me
VITE_AMAP_SECURITY_CODE=replace_me
